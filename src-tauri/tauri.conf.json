{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jn-clipboard",
  "version": "1.0.10",
  "identifier": "com.jnarrator.jnclipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "jn-clipboard",
        "label": "main",
        "width": 352,
        "height": 380,
        "minWidth": 250,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": false,
        "decorations": false,
        "devtools": false,
        "skipTaskbar": true,
        "visible": true,
        "visibleOnAllWorkspaces": true,
        "dragDropEnabled": false,
        "acceptFirstMouse": true,
        "focusable": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: http: https:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: http://127.0.0.1:*; video-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: http: https:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$HOME/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$PROFILE/**"
        ]
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/app.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "dmg",
      "app"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFRTQ1RTE0QzAwNDU5ClJXUlpCTUFVWHVST0FMNDZkNnpaT2xDeUpUT0VNQ0JwR2JnblVkZVdGSzh1a1FCYWNzenhvOTB5Cg==",
      "endpoints": [
        "https://jiangnan.88933.vip/clipboard-update/latest.json",
        "https://github.com/JNNarrator/jn-clipboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
